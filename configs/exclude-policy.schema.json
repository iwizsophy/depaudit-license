{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/depaudit-license/exclude-policy.schema.json",
  "title": "depaudit-license exclude policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": {
      "type": "string",
      "const": "v1alpha1"
    },
    "shallowExcludes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/shallowRule"
      }
    },
    "subgraphExcludes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/subgraphRule"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ecosystems": {
          "$ref": "#/$defs/stringList"
        },
        "names": {
          "$ref": "#/$defs/stringList"
        },
        "nameGlobs": {
          "$ref": "#/$defs/stringList"
        },
        "versions": {
          "$ref": "#/$defs/stringList"
        },
        "projects": {
          "$ref": "#/$defs/stringList"
        },
        "dependencyTypes": {
          "$ref": "#/$defs/stringList"
        },
        "hasRuntimeAssets": {
          "type": "boolean"
        },
        "purls": {
          "$ref": "#/$defs/stringList"
        }
      },
      "anyOf": [
        { "required": ["ecosystems"] },
        { "required": ["names"] },
        { "required": ["nameGlobs"] },
        { "required": ["versions"] },
        { "required": ["projects"] },
        { "required": ["dependencyTypes"] },
        { "required": ["hasRuntimeAssets"] },
        { "required": ["purls"] }
      ]
    },
    "shallowRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["match"],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "reason": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "match": {
          "$ref": "#/$defs/selector"
        }
      }
    },
    "subgraphRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["match"],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "reason": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "match": {
          "$ref": "#/$defs/selector"
        },
        "onUnsupported": {
          "type": "string",
          "enum": ["warn", "error", "ignore"]
        }
      }
    }
  }
}
